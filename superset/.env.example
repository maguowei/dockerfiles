# docker-compose.yaml 的环境变量模板。
#
#   cp .env.example .env
#
# 然后填好下面标了「必填」的四项。.env 含明文密码，已被 .gitignore 排除，不要提交。

# ── 必填 ────────────────────────────────────────────────────────────────────

# 会话加密密钥，必须固定；变更会导致已保存的数据库凭据全部失效。
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=

# MySQL root 密码，仅 db 容器初始化时使用。
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# Superset 连 metadata 库用的密码，db 容器首次启动时据此创建该用户。
#   openssl rand -base64 24
DATABASE_PASSWORD=

# MCP 服务的 JWT 签名密钥。不配 MCP 端点就没有任何访问控制，故 compose 用
# :?required 强制填写。签发 token 时必须用同一个值，不要把 token 本身填在这里。
#   openssl rand -base64 32
MCP_JWT_SECRET=

# ── 可选，留空或注释掉即用下面标注的默认值 ───────────────────────────────────

# metadata 库名与用户名，db 容器首次启动时据此创建。
# DATABASE_DB=superset
# DATABASE_USER=superset

# 宿主机映射端口。容器内固定为 8088 / 5008，这里只改宿主机侧。
# SUPERSET_PORT=8088
# MCP_PORT=5008

# 所有 MCP 请求的执行身份，必须是已存在的 Superset 用户；
# 该用户的 RBAC/RLS 权限就是 AI 客户端的权限上限。
# MCP_DEV_USERNAME=admin

# 对外访问地址，MCP 工具生成的 explore / SQL Lab 链接以此为前缀。
# 部署到服务器或走反代时改成实际地址。
# SUPERSET_PUBLIC_URL=http://localhost:8088
